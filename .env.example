# ---------------------------------------------------------------------------
# Copy to `.env` for local dev. Set the same values in the Vercel dashboard
# (Production + Preview). Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime DB connection — Supabase → Connect → "Transaction pooler" (port 6543).
# Append ?pgbouncer=true. Used by the app (server/db.ts).
DATABASE_URL=postgresql://postgres.jqqdqleggbaskuosrlps:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Migrations only (local) — Supabase → Connect → "Direct connection" (port 5432).
# Used by drizzle-kit (drizzle.config.ts). Not needed in Vercel.
DATABASE_URL_DIRECT=postgresql://postgres.jqqdqleggbaskuosrlps:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase project — server-side JWT verification (server/_core/supabaseAuth.ts)
SUPABASE_URL=https://jqqdqleggbaskuosrlps.supabase.co

# Comma-separated list of emails granted the admin role on sign-in
ADMIN_EMAILS=you@example.com

# Client (baked into the bundle at build time)
VITE_SUPABASE_URL=https://jqqdqleggbaskuosrlps.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Optional — only if the Supabase project still uses legacy HS256 auth keys
# SUPABASE_JWT_SECRET=
